{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juggl",
  "version": "0.1.0",
  "identifier": "app.juggl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Juggl",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360
      },
      {
        "label": "captura",
        "title": "Juggl: captura",
        "url": "index.html",
        "width": 640,
        "height": 64,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
