{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juggl",
  "version": "0.1.2",
  "identifier": "app.juggl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Juggl",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": false
      },
      {
        "label": "captura",
        "title": "Juggl: nova tarefa",
        "url": "index.html",
        "width": 640,
        "height": 64,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "focus": true,
        "shadow": true
      },
      {
        "label": "nota",
        "title": "Juggl: nota",
        "url": "index.html",
        "width": 560,
        "height": 64,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MDBDNUU1QjAyQzE2RUYKUldUdkZpeXc1Y1VBNWM2VlB3RWl4ZWpNM3pIVHNWOG5oQjZ3ajV2UE1yaHVlaWtCaFJxd084OWcK",
      "endpoints": [
        "https://github.com/walterretke/juggl-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
